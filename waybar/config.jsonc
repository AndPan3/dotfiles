{
    "layer": "top",
    "position": "top",
    "zheight": 36,

    "modules-left": [
        "cpu",
        "memory"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "backlight",
        "network",
        "battery",
        "bluetooth",
        "pulseaudio"
    ],

    // MODULE CONFIGURATIONS

    "cpu": {
        "format": ": {usage}%",
        "interval": 1
    },

    "memory": {
        "format": ": {percentage}%",
        "interval": 1
    },

    "clock": {
        "on-click": "kitty -e ~/.cargo/bin/tclock"
    },

    "tray": {
        "spacing": 10
    },

    "network": {
        "format": "󰤨{essid}",
        "format-disconnected": "󰤫",
        "format-disabled": "󰤮",
        "interval": 2,
        "on-click": "kitty -e nmtui"
    },

    "battery": {
        "format": "{icon}: {capacity}%",
        "format-charging": "{󰂄} {capacity}%",
        "format-full": "{󰁹} {capacity}%",
        "format-icons": [
            "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ]
    },
    "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "󰝟",
    "on-click": "pavucontrol",
    "interval": 0.2
},
    "backlight": {
        "format": ": {percent}%",
        "format-disabled": ": Disabled",
        "interval": 0.3,
        "on-click": "kitty -e lumiere"
    },
    "bluetooth": {
        "format": ": {status}",
        "interval": 2,
        "on-click": "kitty -e blueman-manager"
    }
}